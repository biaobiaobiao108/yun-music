{
  "name": "yun-yin-web-server",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "prestart": "bun run scripts/download-binary.js && bun run scripts/update-build-hash.js",
    "start": "bun run src/index.ts",
    "predev": "bun run scripts/update-build-hash.js",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./server --target bun --packages=external",
    "build:frontend": "bun run scripts/build-frontend.ts",
    "check:frontend-assets": "bun run scripts/check-frontend-assets.ts",
    "reset:instance": "bun run scripts/reset-instance.ts",
    "dev:frontend": "bun run scripts/build-frontend.ts --watch",
    "test": "bun test"
  },
  "engines": {
    "bun": ">= 1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biaobiaobiao108/yun-music.git"
  },
  "bugs": {
    "url": "https://github.com/biaobiaobiao108/yun-music/issues"
  },
  "homepage": "https://github.com/biaobiaobiao108/yun-music#readme",
  "dependencies": {
    "archiver": "^8.0.0",
    "log4js": "^6.9.1",
    "music-tag-native": "^0.2.5",
    "socks-proxy-agent": "^10.1.0",
    "vm2": "^3.12.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bun": "latest",
    "@types/crypto-js": "4.2.2",
    "@types/pako": "2.0.3",
    "bun-plugin-tailwind": "0.1.2",
    "crypto-js": "4.2.0",
    "marked": "15.0.12",
    "nosleep.js": "0.12.0",
    "pako": "2.1.0",
    "sortablejs": "1.15.2",
    "tailwindcss": "4.1.18",
    "typescript": "^7.0.2"
  }
}
