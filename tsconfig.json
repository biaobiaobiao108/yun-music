{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "bun-types"
    ],
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@renderer/*": [
        "./src/modules/*"
      ]
    }
  },
  "include": [
    "src",
    "frontend/**/*.tsx",
    "frontend/shared/**/*.ts",
    "frontend/admin/src/react/**/*.ts",
    "frontend/player/src/react/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
